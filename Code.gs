// ─── STORAGE: a JSON file in this script's Drive (no Google Sheet) ──────────
// The file's ID is cached in Script Properties after first creation, so it
// never needs to be re-located. Layout:
//   { "<batch>": { dates: ["02-Jun-2026", ...], students: { "<name>": ["P","A",...] } },
//     submitted: { "<date>": ["<batch>", ...] } }
function getAttendanceFile() {
  const props  = PropertiesService.getScriptProperties();
  const fileId = props.getProperty('ATTENDANCE_FILE_ID');

  if (fileId) {
    try { return DriveApp.getFileById(fileId); } catch (e) { /* recreate below */ }
  }

  const file = DriveApp.createFile('DPS Attendance Data.json', JSON.stringify(SEED_DB), MimeType.PLAIN_TEXT);
  props.setProperty('ATTENDANCE_FILE_ID', file.getId());
  return file;
}

function readDb() {
  const file = getAttendanceFile();
  let db;
  try { db = JSON.parse(file.getBlob().getDataAsString()); } catch (e) { db = {}; }

  Object.keys(STUDENTS).forEach(function(batch) {
    if (!db[batch]) db[batch] = { dates: [], students: {} };
  });
  if (!db.submitted) db.submitted = {};

  return db;
}

function writeDb(db) {
  getAttendanceFile().setContent(JSON.stringify(db));
}

// Run from the Apps Script editor any time to find the underlying data file
// (e.g. to download a backup copy).
function logStoreInfo() {
  const url = getAttendanceFile().getUrl();
  Logger.log('Attendance data file: ' + url);
  return url;
}

// Moves one student's full P/A history from one batch to another inside the
// store (dates that don't yet exist in the destination are added). Run this
// from the Apps Script editor's function dropdown whenever a student changes
// batch and you want their history carried over — safe to re-run: once the
// student is gone from `fromBatch` it just logs "not found" and does nothing.
function moveStudentBatch(name, fromBatch, toBatch) {
  const db = readDb();
  const from = db[fromBatch];
  const to = db[toBatch] || (db[toBatch] = { dates: [], students: {} });

  if (!from || !from.students[name]) {
    const msg = 'Not found: ' + name + ' in ' + fromBatch + ' (already moved, or never had a record)';
    Logger.log(msg);
    return msg;
  }

  from.dates.forEach(function(date, i) {
    const val = from.students[name][i];
    if (!val) return;

    let idx = to.dates.indexOf(date);
    if (idx === -1) {
      idx = to.dates.length;
      to.dates.push(date);
      Object.keys(to.students).forEach(function(n) {
        while (to.students[n].length <= idx) to.students[n].push('');
      });
    }
    if (!to.students[name]) to.students[name] = to.dates.map(function() { return ''; });
    while (to.students[name].length <= idx) to.students[name].push('');
    to.students[name][idx] = val;
  });

  if (!to.students[name]) to.students[name] = to.dates.map(function() { return ''; });

  delete from.students[name];
  writeDb(db);
  const msg = 'Moved ' + name + ' from ' + fromBatch + ' to ' + toBatch;
  Logger.log(msg);
  return msg;
}

// One-off: run this once from the editor, then it's safe to leave in place.
function moveAkshaySathishToMains() {
  return moveStudentBatch('Akshay Sathish', 'XI-Adv B', 'XI-Mains');
}

function gasJson(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// ─── WEB APP: POST handler ────────────────────────────────────────────────────
function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const data       = JSON.parse(e.postData.contents);
    const batch      = data.batch;
    const dateStr    = data.date;        // e.g. "02-Jun-2026"
    const attendance = data.attendance;  // [{name, status}, ...]

    const db = readDb();
    const bd = db[batch] || (db[batch] = { dates: [], students: {} });

    let dateIdx = bd.dates.indexOf(dateStr);
    if (dateIdx === -1) {
      dateIdx = bd.dates.length;
      bd.dates.push(dateStr);
    }

    // Every student the batch has ever had a record for keeps an array the
    // same length as bd.dates, so lookup-by-index always lines up.
    (STUDENTS[batch] || []).forEach(function(name) {
      if (!bd.students[name]) bd.students[name] = [];
    });
    Object.keys(bd.students).forEach(function(name) {
      const arr = bd.students[name];
      while (arr.length <= dateIdx) arr.push('');
    });

    attendance.forEach(function(item) {
      const name = String(item.name).trim();
      if (!bd.students[name]) bd.students[name] = [];
      const arr = bd.students[name];
      while (arr.length <= dateIdx) arr.push('');
      arr[dateIdx] = item.status;
    });

    if (!db.submitted[dateStr]) db.submitted[dateStr] = [];
    if (db.submitted[dateStr].indexOf(batch) === -1) db.submitted[dateStr].push(batch);

    writeDb(db);

    return gasJson({ success: true });

  } catch (err) {
    return gasJson({ success: false, error: err.message });
  } finally {
    lock.releaseLock();
  }
}

function doGet(e) {
  const params = (e && e.parameter) || {};

  if (params.action === 'history' && params.batch) {
    return getBatchHistory(params.batch);
  }

  if (params.action === 'student' && params.name && params.batch) {
    return getStudentAttendance(params.name, params.batch);
  }

  const date = params.date;
  if (!date) {
    return gasJson({ status: 'DPS Attendance API running' });
  }

  const db = readDb();
  return gasJson({ submitted: db.submitted[date] || [] });
}

// Returns the full P/A grid for a batch: every date column ever submitted,
// per student, read straight from the store (so it's always in sync with
// what the attendance app itself has recorded).
function getBatchHistory(batch) {
  const db = readDb();
  const bd = db[batch];
  if (!bd) return gasJson({ error: 'Batch not found: ' + batch });

  const students = Object.keys(bd.students).map(function(name) {
    return { name: name, records: bd.students[name] };
  });

  return gasJson({ batch: batch, dates: bd.dates, students: students });
}

// Returns one student's P/A record across all dates for their batch.
function getStudentAttendance(name, batch) {
  const db = readDb();
  const bd = db[batch];
  if (!bd) return gasJson({ error: 'Batch not found: ' + batch });

  const nameLow = name.trim().toLowerCase();
  const match   = Object.keys(bd.students).find(function(n) { return n.toLowerCase() === nameLow; });
  const records = match ? bd.students[match] : bd.dates.map(function() { return ''; });

  return gasJson({ name: match || name, batch: batch, dates: bd.dates, records: records });
}
